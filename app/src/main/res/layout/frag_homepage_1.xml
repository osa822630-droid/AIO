<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/NestedScrollView"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/_14"
    android:paddingTop="@dimen/_36"
    android:paddingEnd="@dimen/_14"
    android:paddingBottom="@dimen/_100">

    <!-- Top Header Bar with Theme & Language Quick Switches -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:layout_width="@dimen/_34"
        android:layout_height="@dimen/_34"
        android:src="@drawable/img_app_logo"
        tools:ignore="ContentDescription" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tvAppHeaderTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/font_family_bold"
          android:text="@string/label_app_name_full"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/title_text_size" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/font_family_regular"
          android:text="@string/app_header_subtitle"
          android:textColor="@color/style_color_text_secondary"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <ImageView
        android:id="@+id/btnToggleTheme"
        android:layout_width="@dimen/_34"
        android:layout_height="@dimen/_34"
        android:layout_marginEnd="@dimen/_6"
        android:background="@drawable/bg_button_negative"
        android:padding="@dimen/_7"
        android:src="@drawable/ic_theme_mode"
        android:tint="@color/style_color_text_primary"
        tools:ignore="ContentDescription,UseAppTint" />

      <TextView
        android:id="@+id/btnToggleLang"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_34"
        android:layout_marginEnd="@dimen/_6"
        android:background="@drawable/bg_button_negative"
        android:fontFamily="@font/font_family_bold"
        android:gravity="center"
        android:paddingStart="@dimen/_10"
        android:paddingEnd="@dimen/_10"
        android:text="@string/btn_lang_switch_label"
        android:textColor="@color/style_color_primary"
        android:textSize="@dimen/small_text_size" />

      <ImageView
        android:id="@+id/btnOpenLanguage"
        android:layout_width="@dimen/_34"
        android:layout_height="@dimen/_34"
        android:layout_marginEnd="@dimen/_6"
        android:background="@drawable/bg_button_negative"
        android:padding="@dimen/_7"
        android:src="@drawable/ic_language"
        android:tint="@color/style_color_text_primary"
        tools:ignore="ContentDescription,UseAppTint" />

      <ImageView
        android:id="@+id/btnOpenSettings"
        android:layout_width="@dimen/_34"
        android:layout_height="@dimen/_34"
        android:background="@drawable/bg_button_negative"
        android:padding="@dimen/_7"
        android:src="@drawable/ic_settings"
        android:tint="@color/style_color_text_primary"
        tools:ignore="ContentDescription,UseAppTint" />
    </LinearLayout>

    <!-- Card 1: URL Input & Auto-Fetch (Supports Single Media + Playlists) -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_14"
      android:background="@drawable/bg_m3e_card"
      android:orientation="vertical"
      android:padding="@dimen/_12">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/font_family_semibold"
          android:text="@string/hint_url_platforms"
          android:textColor="@color/style_color_text_secondary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/btnUpdateYtDlp"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/_26"
          android:layout_marginStart="@dimen/_6"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:paddingStart="@dimen/_8"
          android:paddingEnd="@dimen/_8"
          android:text="@string/btn_update_engine"
          android:textColor="@color/style_color_primary"
          android:textSize="@dimen/smaller_text_size" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8"
        android:background="@drawable/bg_m3e_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_6">

        <EditText
          android:id="@+id/editMediaUrl"
          android:layout_width="0dp"
          android:layout_height="@dimen/_38"
          android:layout_weight="1"
          android:background="@color/style_color_transparent"
          android:fontFamily="@font/font_family_regular"
          android:hint="@string/hint_paste_url"
          android:importantForAutofill="no"
          android:inputType="textUri"
          android:paddingStart="@dimen/_8"
          android:paddingEnd="@dimen/_8"
          android:singleLine="true"
          android:textColor="@color/style_color_text_primary"
          android:textColorHint="@color/style_color_text_hint"
          android:textSize="@dimen/message_text_size" />

        <ImageView
          android:id="@+id/btnClearUrl"
          android:layout_width="@dimen/_30"
          android:layout_height="@dimen/_30"
          android:layout_marginEnd="@dimen/_4"
          android:background="@drawable/bg_button_negative"
          android:padding="@dimen/_6"
          android:src="@drawable/ic_close_cross"
          android:tint="@color/style_color_text_secondary"
          tools:ignore="ContentDescription,UseAppTint" />

        <TextView
          android:id="@+id/btnPasteUrl"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/_32"
          android:layout_marginEnd="@dimen/_4"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:paddingStart="@dimen/_10"
          android:paddingEnd="@dimen/_10"
          android:text="@string/btn_paste"
          android:textColor="@color/style_color_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/btnFetchUrlInfo"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/_32"
          android:background="@drawable/bg_button_accent"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:paddingStart="@dimen/_12"
          android:paddingEnd="@dimen/_12"
          android:text="@string/btn_analyze"
          android:textColor="@color/style_color_text_inverse"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <ProgressBar
        android:id="@+id/pbFetchLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_6"
        android:layout_marginTop="@dimen/_6"
        android:indeterminate="true"
        android:visibility="gone" />
    </LinearLayout>

    <!-- Card 2A: Single Media Preview & Duration Calculator -->
    <LinearLayout
      android:id="@+id/cardMediaPreview"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_10"
      android:background="@drawable/bg_m3e_card"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:padding="@dimen/_10"
      android:visibility="gone">

      <ImageView
        android:id="@+id/imgPreviewThumb"
        android:layout_width="@dimen/_80"
        android:layout_height="@dimen/_56"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_media_placeholder"
        tools:ignore="ContentDescription" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tvPreviewTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="@font/font_family_semibold"
          android:maxLines="2"
          android:text="@string/label_sample_video_title"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/message_text_size" />

        <TextView
          android:id="@+id/tvPreviewUploader"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/_2"
          android:fontFamily="@font/font_family_regular"
          android:text="@string/label_channel_name"
          android:textColor="@color/style_color_text_secondary"
          android:textSize="@dimen/small_text_size" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/_4"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/tvPreviewDurationCalc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/font_family_bold"
            android:text=""
            android:textColor="@color/style_color_primary"
            android:textSize="@dimen/small_text_size" />

          <TextView
            android:id="@+id/btnPreviewStreamSpeed"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_28"
            android:layout_marginStart="@dimen/_6"
            android:background="@drawable/bg_button_accent"
            android:fontFamily="@font/font_family_semibold"
            android:gravity="center"
            android:paddingStart="@dimen/_10"
            android:paddingEnd="@dimen/_10"
            android:text="@string/btn_preview_speed"
            android:textColor="@color/style_color_text_inverse"
            android:textSize="@dimen/smaller_text_size" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>

    <!-- Card 2B: Playlist Preview & Item Selector -->
    <LinearLayout
      android:id="@+id/cardPlaylistPreview"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_10"
      android:background="@drawable/bg_m3e_card"
      android:orientation="vertical"
      android:padding="@dimen/_12"
      android:visibility="gone">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/tvPlaylistTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/font_family_bold"
            android:maxLines="2"
            android:text="@string/label_playlist"
            android:textColor="@color/style_color_text_primary"
            android:textSize="@dimen/message_text_size" />

          <TextView
            android:id="@+id/tvPlaylistCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2"
            android:fontFamily="@font/font_family_regular"
            android:text=""
            android:textColor="@color/style_color_primary"
            android:textSize="@dimen/small_text_size" />
        </LinearLayout>

        <TextView
          android:id="@+id/btnPlaylistSelectAll"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/_32"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:paddingStart="@dimen/_10"
          android:paddingEnd="@dimen/_10"
          android:text="@string/btn_select_all"
          android:textColor="@color/style_color_primary"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylistItems"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_220"
        android:layout_marginTop="@dimen/_8"
        android:nestedScrollingEnabled="true" />

      <TextView
        android:id="@+id/btnDownloadPlaylist"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42"
        android:layout_marginTop="@dimen/_10"
        android:background="@drawable/bg_button_gradient"
        android:fontFamily="@font/font_family_bold"
        android:gravity="center"
        android:text="@string/btn_download_playlist_default"
        android:textColor="@color/style_color_text_inverse"
        android:textSize="@dimen/normal_text_size" />
    </LinearLayout>

    <!-- Card 3: Speed Control Studio -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_10"
      android:background="@drawable/bg_m3e_card"
      android:orientation="vertical"
      android:padding="@dimen/_12">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:layout_width="@dimen/_20"
          android:layout_height="@dimen/_20"
          android:src="@drawable/ic_speed_meter"
          android:tint="@color/style_color_primary"
          tools:ignore="ContentDescription,UseAppTint" />

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/_6"
          android:layout_weight="1"
          android:fontFamily="@font/font_family_bold"
          android:text="@string/title_speed_control"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/message_text_size" />

        <TextView
          android:id="@+id/tvCurrentSpeedBadge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_m3e_badge"
          android:fontFamily="@font/font_family_bold"
          android:paddingStart="@dimen/_10"
          android:paddingTop="@dimen/_4"
          android:paddingEnd="@dimen/_10"
          android:paddingBottom="@dimen/_4"
          android:text="1.5x"
          android:textColor="@color/style_color_primary"
          android:textSize="@dimen/normal_text_size" />
      </LinearLayout>

      <!-- Speed Presets Row 1 -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/chipSpeed075"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="0.75x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/chipSpeed100"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="1.0x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/chipSpeed125"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="1.25x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/chipSpeed150"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_weight="1"
          android:background="@drawable/bg_button_accent"
          android:fontFamily="@font/font_family_bold"
          android:gravity="center"
          android:text="1.5x"
          android:textColor="@color/style_color_text_inverse"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <!-- Speed Presets Row 2 -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/chipSpeed175"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="1.75x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/chipSpeed200"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="2.0x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/chipSpeed250"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="2.5x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/chipSpeed300"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="3.0x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <!-- Custom Fine Slider -->
      <SeekBar
        android:id="@+id/seekSpeedControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8"
        android:max="50"
        android:progress="20" />

      <TextView
        android:id="@+id/tvSpeedHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_family_regular"
        android:gravity="center"
        android:text="@string/hint_speed_slider"
        android:textColor="@color/style_color_text_tertiary"
        android:textSize="@dimen/smaller_text_size" />
    </LinearLayout>

    <!-- Card 4: Format, Quality & Processing Mode -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_10"
      android:background="@drawable/bg_m3e_card"
      android:orientation="vertical"
      android:padding="@dimen/_12">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_family_bold"
        android:text="@string/title_format_quality_mode"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/message_text_size" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/btnTypeVideoMp4"
          android:layout_width="0dp"
          android:layout_height="@dimen/_36"
          android:layout_marginEnd="@dimen/_6"
          android:layout_weight="1"
          android:background="@drawable/bg_button_accent"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="@string/btn_video_mp4"
          android:textColor="@color/style_color_text_inverse"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/btnTypeAudioM4a"
          android:layout_width="0dp"
          android:layout_height="@dimen/_36"
          android:layout_marginEnd="@dimen/_6"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="@string/btn_audio_m4a"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/btnTypeAudioMp3"
          android:layout_width="0dp"
          android:layout_height="@dimen/_36"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="@string/btn_audio_mp3"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <!-- Video Qualities -->
      <LinearLayout
        android:id="@+id/layoutVideoQualities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/chipQ1080"
          android:layout_width="0dp"
          android:layout_height="@dimen/_32"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:gravity="center"
          android:text="@string/quality_1080p"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/chipQ720"
          android:layout_width="0dp"
          android:layout_height="@dimen/_32"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_accent"
          android:gravity="center"
          android:text="@string/quality_720p"
          android:textColor="@color/style_color_text_inverse"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/chipQ480"
          android:layout_width="0dp"
          android:layout_height="@dimen/_32"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:gravity="center"
          android:text="@string/quality_480p"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/chipQ360"
          android:layout_width="0dp"
          android:layout_height="@dimen/_32"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:gravity="center"
          android:text="@string/quality_360p_saver"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <!-- Video Speed Engine Mode -->
      <LinearLayout
        android:id="@+id/layoutVideoSpeedModes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/btnTurboLosslessMode"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_6"
          android:layout_weight="1"
          android:background="@drawable/bg_button_accent"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="@string/mode_turbo_video"
          android:textColor="@color/style_color_text_inverse"
          android:textSize="@dimen/smaller_text_size" />

        <TextView
          android:id="@+id/btnCompatReencodeMode"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="@string/mode_compat_video"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/smaller_text_size" />
      </LinearLayout>

      <!-- Smart Audio Boost & Synced Subtitles Toggles -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/btnVoiceBoost"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_6"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="@string/btn_voice_boost"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/smaller_text_size" />

        <TextView
          android:id="@+id/btnSyncSubtitles"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:fontFamily="@font/font_family_semibold"
          android:gravity="center"
          android:text="@string/btn_sync_subtitles"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/smaller_text_size" />
      </LinearLayout>
    </LinearLayout>

    <!-- Primary Download Button -->
    <TextView
      android:id="@+id/btnDownloadWithSpeed"
      android:layout_width="match_parent"
      android:layout_height="@dimen/_46"
      android:layout_marginTop="@dimen/_12"
      android:background="@drawable/bg_button_gradient"
      android:fontFamily="@font/font_family_bold"
      android:gravity="center"
      android:text="@string/btn_download_with_speed_default"
      android:textColor="@color/style_color_text_inverse"
      android:textSize="@dimen/normal_text_size" />

    <!-- Live Active Task Banner -->
    <LinearLayout
      android:id="@+id/cardActiveTaskBanner"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_12"
      android:background="@drawable/bg_m3e_card_selected"
      android:orientation="vertical"
      android:padding="@dimen/_12"
      android:visibility="gone">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tvActiveTaskTitle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="@font/font_family_semibold"
          android:maxLines="1"
          android:text="@string/status_downloading_ellipsis"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/message_text_size" />

        <TextView
          android:id="@+id/btnViewAllDownloads"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/font_family_bold"
          android:padding="@dimen/_4"
          android:text="@string/btn_view_downloads"
          android:textColor="@color/style_color_primary"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <TextView
        android:id="@+id/tvActiveTaskStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4"
        android:fontFamily="@font/font_family_regular"
        android:text="@string/_0_percentage"
        android:textColor="@color/style_color_text_secondary"
        android:textSize="@dimen/small_text_size" />

      <ProgressBar
        android:id="@+id/pbActiveTaskProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_8"
        android:layout_marginTop="@dimen/_6"
        android:max="100"
        android:progress="0" />
    </LinearLayout>

  </LinearLayout>

</androidx.core.widget.NestedScrollView>
