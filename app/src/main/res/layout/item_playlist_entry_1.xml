<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="@dimen/_6"
  android:background="@color/style_color_surface_variant"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="@dimen/_8">

  <CheckBox
    android:id="@+id/cbPlaylistItem"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checked="true" />

  <ImageView
    android:id="@+id/imgPlaylistThumb"
    android:layout_width="@dimen/_54"
    android:layout_height="@dimen/_38"
    android:layout_marginStart="@dimen/_4"
    android:scaleType="centerCrop"
    android:src="@drawable/bg_media_placeholder"
    tools:ignore="ContentDescription" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_8"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/tvPlaylistItemTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="@font/font_family_medium"
      android:maxLines="2"
      android:text="Title"
      android:textColor="@color/style_color_text_primary"
      android:textSize="@dimen/small_text_size" />

    <TextView
      android:id="@+id/tvPlaylistItemDuration"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_2"
      android:fontFamily="@font/font_family_regular"
      android:text="00:00"
      android:textColor="@color/style_color_text_secondary"
      android:textSize="@dimen/smaller_text_size" />
  </LinearLayout>

</LinearLayout>
