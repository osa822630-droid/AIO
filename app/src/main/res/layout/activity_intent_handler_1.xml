<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/rootOverlay"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/style_color_shadow_dark"
  android:clickable="true"
  android:focusable="true">

  <LinearLayout
    android:id="@+id/bottomSheetCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@color/style_color_surface"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/_16">

    <!-- Top Handle & Header -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:layout_width="@dimen/_24"
        android:layout_height="@dimen/_24"
        android:src="@drawable/ic_speed_meter"
        android:tint="@color/style_color_primary"
        tools:ignore="ContentDescription,UseAppTint" />

      <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8"
        android:layout_weight="1"
        android:fontFamily="@font/font_family_bold"
        android:text="@string/title_quick_speed_sheet"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/sub_heading_text_size" />

      <TextView
        android:id="@+id/tvPlatformBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_8"
        android:background="@color/style_color_chip_selected"
        android:fontFamily="@font/font_family_semibold"
        android:paddingStart="@dimen/_8"
        android:paddingTop="@dimen/_4"
        android:paddingEnd="@dimen/_8"
        android:paddingBottom="@dimen/_4"
        android:text="YouTube"
        android:textColor="@color/style_color_primary"
        android:textSize="@dimen/small_text_size" />

      <ImageView
        android:id="@+id/btnCloseSheet"
        android:layout_width="@dimen/_28"
        android:layout_height="@dimen/_28"
        android:background="@drawable/bg_button_negative"
        android:padding="@dimen/_6"
        android:src="@drawable/ic_close_cross"
        android:tint="@color/style_color_text_secondary"
        tools:ignore="ContentDescription,UseAppTint" />
    </LinearLayout>

    <!-- Media Info Preview Row -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_12"
      android:background="@color/style_color_card"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:padding="@dimen/_10">

      <ImageView
        android:id="@+id/imgMediaThumb"
        android:layout_width="@dimen/_60"
        android:layout_height="@dimen/_45"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_media_placeholder"
        tools:ignore="ContentDescription" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/tvMediaTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="@font/font_family_semibold"
          android:maxLines="2"
          android:text="@string/status_fetching_media_info"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/message_text_size" />

        <TextView
          android:id="@+id/tvDurationComparison"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/_4"
          android:fontFamily="@font/font_family_medium"
          android:text=""
          android:textColor="@color/style_color_secondary"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <ProgressBar
        android:id="@+id/pbMetadataLoading"
        android:layout_width="@dimen/_24"
        android:layout_height="@dimen/_24"
        android:layout_marginStart="@dimen/_6"
        android:visibility="visible" />
    </LinearLayout>

    <!-- Speed Presets Section -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_12"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/font_family_semibold"
        android:text="@string/title_speed_control"
        android:textColor="@color/style_color_text_secondary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/tvSelectedSpeedValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_family_bold"
        android:text="1.5x"
        android:textColor="@color/style_color_primary"
        android:textSize="@dimen/normal_text_size" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_6"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/btnSpeed100"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34"
        android:layout_marginEnd="@dimen/_4"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:text="1.0x"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnSpeed125"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34"
        android:layout_marginEnd="@dimen/_4"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:text="1.25x"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnSpeed150"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34"
        android:layout_marginEnd="@dimen/_4"
        android:layout_weight="1"
        android:background="@drawable/bg_button_accent"
        android:fontFamily="@font/font_family_bold"
        android:gravity="center"
        android:text="1.5x"
        android:textColor="@color/style_color_text_inverse"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnSpeed175"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34"
        android:layout_marginEnd="@dimen/_4"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:text="1.75x"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnSpeed200"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34"
        android:layout_marginEnd="@dimen/_4"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:text="2.0x"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnSpeed250"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:text="2.5x"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />
    </LinearLayout>

    <SeekBar
      android:id="@+id/seekCustomSpeed"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_6"
      android:max="50"
      android:progress="20" />

    <!-- Format Type Selection (Video MP4 vs Audio M4A / MP3) -->
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_10"
      android:fontFamily="@font/font_family_semibold"
      android:text="@string/label_download_format"
      android:textColor="@color/style_color_text_secondary"
      android:textSize="@dimen/small_text_size" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_6"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/btnFormatVideo"
        android:layout_width="0dp"
        android:layout_height="@dimen/_36"
        android:layout_marginEnd="@dimen/_6"
        android:layout_weight="1"
        android:background="@drawable/bg_button_accent"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:text="@string/btn_video_mp4"
        android:textColor="@color/style_color_text_inverse"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnFormatAudioM4a"
        android:layout_width="0dp"
        android:layout_height="@dimen/_36"
        android:layout_marginEnd="@dimen/_6"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:text="@string/btn_audio_m4a"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnFormatAudioMp3"
        android:layout_width="0dp"
        android:layout_height="@dimen/_36"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:text="@string/btn_audio_mp3"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />
    </LinearLayout>

    <!-- Video Quality Row -->
    <LinearLayout
      android:id="@+id/layoutQualityRow"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_8"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/btnQuality1080"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32"
        android:layout_marginEnd="@dimen/_4"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:gravity="center"
        android:text="1080p"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnQuality720"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32"
        android:layout_marginEnd="@dimen/_4"
        android:layout_weight="1"
        android:background="@drawable/bg_button_accent"
        android:gravity="center"
        android:text="720p"
        android:textColor="@color/style_color_text_inverse"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnQuality480"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32"
        android:layout_marginEnd="@dimen/_4"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:gravity="center"
        android:text="480p"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnQuality360"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32"
        android:layout_weight="1"
        android:background="@drawable/bg_button_negative"
        android:gravity="center"
        android:text="360p"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />
    </LinearLayout>

    <!-- Primary Download Action Button -->
    <TextView
      android:id="@+id/btnStartSpeedDownload"
      android:layout_width="match_parent"
      android:layout_height="@dimen/_44"
      android:layout_marginTop="@dimen/_14"
      android:background="@drawable/bg_button_gradient"
      android:fontFamily="@font/font_family_bold"
      android:gravity="center"
      android:text="@string/btn_start_speed_download_default"
      android:textColor="@color/style_color_text_inverse"
      android:textSize="@dimen/normal_text_size" />

  </LinearLayout>

</FrameLayout>
