<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="@dimen/_14"
  android:paddingTop="@dimen/_36"
  android:paddingEnd="@dimen/_14"
  android:paddingBottom="@dimen/_90">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:fontFamily="@font/font_family_bold"
      android:text="@string/title_downloads_manager"
      android:textColor="@color/style_color_text_primary"
      android:textSize="@dimen/title_text_size" />

    <TextView
      android:id="@+id/tvDownloadsSummary"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/font_family_semibold"
      android:text=""
      android:textColor="@color/style_color_primary"
      android:textSize="@dimen/small_text_size" />
  </LinearLayout>

  <!-- Filter Chips -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_10"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/btnFilterAll"
      android:layout_width="0dp"
      android:layout_height="@dimen/_34"
      android:layout_marginEnd="@dimen/_6"
      android:layout_weight="1"
      android:background="@drawable/bg_button_accent"
      android:fontFamily="@font/font_family_semibold"
      android:gravity="center"
      android:text="@string/filter_all"
      android:textColor="@color/style_color_text_inverse"
      android:textSize="@dimen/small_text_size" />

    <TextView
      android:id="@+id/btnFilterActive"
      android:layout_width="0dp"
      android:layout_height="@dimen/_34"
      android:layout_marginEnd="@dimen/_6"
      android:layout_weight="1"
      android:background="@drawable/bg_button_negative"
      android:fontFamily="@font/font_family_semibold"
      android:gravity="center"
      android:text="@string/filter_active"
      android:textColor="@color/style_color_text_primary"
      android:textSize="@dimen/small_text_size" />

    <TextView
      android:id="@+id/btnFilterCompleted"
      android:layout_width="0dp"
      android:layout_height="@dimen/_34"
      android:layout_weight="1"
      android:background="@drawable/bg_button_negative"
      android:fontFamily="@font/font_family_semibold"
      android:gravity="center"
      android:text="@string/filter_completed"
      android:textColor="@color/style_color_text_primary"
      android:textSize="@dimen/small_text_size" />
  </LinearLayout>

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvDownloadsList"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="@dimen/_10"
    android:layout_weight="1" />

  <LinearLayout
    android:id="@+id/layoutEmptyState"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:id="@+id/tvEmptyStateMsg"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="@font/font_family_medium"
      android:gravity="center"
      android:text="@string/empty_downloads_msg"
      android:textColor="@color/style_color_text_secondary"
      android:textSize="@dimen/message_text_size" />
  </LinearLayout>

</LinearLayout>
