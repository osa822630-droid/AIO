<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/_14"
    android:paddingTop="@dimen/_36"
    android:paddingEnd="@dimen/_14"
    android:paddingBottom="@dimen/_100">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFamily="@font/font_family_bold"
      android:text="@string/title_local_speed"
      android:textColor="@color/style_color_text_primary"
      android:textSize="@dimen/title_text_size" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_4"
      android:fontFamily="@font/font_family_regular"
      android:text="@string/subtitle_local_speed"
      android:textColor="@color/style_color_text_secondary"
      android:textSize="@dimen/small_text_size" />

    <!-- Pick File Card -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_14"
      android:background="@color/style_color_card"
      android:orientation="vertical"
      android:padding="@dimen/_14">

      <TextView
        android:id="@+id/btnPickLocalMedia"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44"
        android:background="@drawable/bg_button_accent"
        android:fontFamily="@font/font_family_bold"
        android:gravity="center"
        android:text="@string/btn_pick_local_media"
        android:textColor="@color/style_color_text_inverse"
        android:textSize="@dimen/normal_text_size" />

      <TextView
        android:id="@+id/tvSelectedLocalFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10"
        android:fontFamily="@font/font_family_semibold"
        android:text="@string/no_file_selected_yet"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/message_text_size" />

      <TextView
        android:id="@+id/tvLocalDurationInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4"
        android:fontFamily="@font/font_family_medium"
        android:text=""
        android:textColor="@color/style_color_primary"
        android:textSize="@dimen/small_text_size" />
    </LinearLayout>

    <!-- Speed & Output Mode Card -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/_12"
      android:background="@color/style_color_card"
      android:orientation="vertical"
      android:padding="@dimen/_14">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/font_family_bold"
          android:text="@string/label_new_speed"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/message_text_size" />

        <TextView
          android:id="@+id/tvLocalSpeedValue"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/font_family_bold"
          android:text="1.5x"
          android:textColor="@color/style_color_primary"
          android:textSize="@dimen/normal_text_size" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/btnLocalSpd125"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:gravity="center"
          android:text="1.25x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/btnLocalSpd150"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_accent"
          android:gravity="center"
          android:text="1.5x"
          android:textColor="@color/style_color_text_inverse"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/btnLocalSpd175"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:gravity="center"
          android:text="1.75x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/btnLocalSpd200"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_marginEnd="@dimen/_4"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:gravity="center"
          android:text="2.0x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/btnLocalSpd250"
          android:layout_width="0dp"
          android:layout_height="@dimen/_34"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:gravity="center"
          android:text="2.5x"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <SeekBar
        android:id="@+id/seekLocalSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8"
        android:max="50"
        android:progress="20" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/btnLocalModeTurboVideo"
          android:layout_width="0dp"
          android:layout_height="@dimen/_36"
          android:layout_marginEnd="@dimen/_6"
          android:layout_weight="1"
          android:background="@drawable/bg_button_accent"
          android:gravity="center"
          android:text="@string/btn_local_turbo_video"
          android:textColor="@color/style_color_text_inverse"
          android:textSize="@dimen/small_text_size" />

        <TextView
          android:id="@+id/btnLocalModeAudioOnly"
          android:layout_width="0dp"
          android:layout_height="@dimen/_36"
          android:layout_weight="1"
          android:background="@drawable/bg_button_negative"
          android:gravity="center"
          android:text="@string/btn_local_audio_only"
          android:textColor="@color/style_color_text_primary"
          android:textSize="@dimen/small_text_size" />
      </LinearLayout>

      <TextView
        android:id="@+id/btnLocalVoiceBoost"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36"
        android:layout_marginTop="@dimen/_10"
        android:background="@drawable/bg_button_negative"
        android:fontFamily="@font/font_family_semibold"
        android:gravity="center"
        android:text="@string/btn_voice_boost"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/btnStartLocalConversion"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46"
        android:layout_marginTop="@dimen/_14"
        android:background="@drawable/bg_button_gradient"
        android:fontFamily="@font/font_family_bold"
        android:gravity="center"
        android:text="@string/btn_start_local_speed"
        android:textColor="@color/style_color_text_inverse"
        android:textSize="@dimen/normal_text_size" />

      <ProgressBar
        android:id="@+id/pbLocalConvertProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_8"
        android:layout_marginTop="@dimen/_10"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

      <TextView
        android:id="@+id/tvLocalConvertStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6"
        android:fontFamily="@font/font_family_regular"
        android:gravity="center"
        android:text=""
        android:textColor="@color/style_color_text_secondary"
        android:textSize="@dimen/small_text_size" />
    </LinearLayout>

  </LinearLayout>

</androidx.core.widget.NestedScrollView>
