<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="@dimen/_10"
  android:background="@drawable/bg_m3e_card"
  android:orientation="vertical"
  android:padding="@dimen/_10">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
      android:layout_width="@dimen/_68"
      android:layout_height="@dimen/_48">

      <ImageView
        android:id="@+id/imgItemThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_media_placeholder"
        tools:ignore="ContentDescription" />

      <TextView
        android:id="@+id/tvItemSpeedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:background="@color/style_color_primary"
        android:fontFamily="@font/font_family_bold"
        android:paddingStart="@dimen/_5"
        android:paddingTop="@dimen/_1"
        android:paddingEnd="@dimen/_5"
        android:paddingBottom="@dimen/_1"
        android:text="1.5x"
        android:textColor="@color/style_color_text_inverse"
        android:textSize="@dimen/smaller_text_size" />
    </FrameLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/_10"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/font_family_semibold"
        android:maxLines="2"
        android:text="@string/label_file_sample_name"
        android:textColor="@color/style_color_text_primary"
        android:textSize="@dimen/message_text_size" />

      <TextView
        android:id="@+id/tvItemStatusInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2"
        android:fontFamily="@font/font_family_regular"
        android:text=""
        android:textColor="@color/style_color_text_secondary"
        android:textSize="@dimen/small_text_size" />

      <TextView
        android:id="@+id/tvItemDurationAndSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2"
        android:fontFamily="@font/font_family_medium"
        android:text="--:--"
        android:textColor="@color/style_color_primary"
        android:textSize="@dimen/smaller_text_size" />
    </LinearLayout>
  </LinearLayout>

  <ProgressBar
    android:id="@+id/pbItemProgress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_6"
    android:layout_marginTop="@dimen/_8"
    android:max="100"
    android:progress="0" />

  <!-- Action Buttons Row -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8"
    android:gravity="end"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/btnItemPlayInternal"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/_30"
      android:layout_marginEnd="@dimen/_6"
      android:background="@drawable/bg_button_accent"
      android:fontFamily="@font/font_family_semibold"
      android:gravity="center"
      android:paddingStart="@dimen/_10"
      android:paddingEnd="@dimen/_10"
      android:text="@string/btn_play_internal"
      android:textColor="@color/style_color_text_inverse"
      android:textSize="@dimen/smaller_text_size" />

    <TextView
      android:id="@+id/btnItemOpenExternal"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/_30"
      android:layout_marginEnd="@dimen/_6"
      android:background="@drawable/bg_button_negative"
      android:fontFamily="@font/font_family_semibold"
      android:gravity="center"
      android:paddingStart="@dimen/_10"
      android:paddingEnd="@dimen/_10"
      android:text="@string/btn_open_external"
      android:textColor="@color/style_color_text_primary"
      android:textSize="@dimen/smaller_text_size" />

    <TextView
      android:id="@+id/btnItemShare"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/_30"
      android:layout_marginEnd="@dimen/_6"
      android:background="@drawable/bg_button_negative"
      android:fontFamily="@font/font_family_semibold"
      android:gravity="center"
      android:paddingStart="@dimen/_10"
      android:paddingEnd="@dimen/_10"
      android:text="@string/btn_share"
      android:textColor="@color/style_color_text_primary"
      android:textSize="@dimen/smaller_text_size" />

    <TextView
      android:id="@+id/btnItemDeleteOrCancel"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/_30"
      android:background="@drawable/bg_button_negative"
      android:fontFamily="@font/font_family_semibold"
      android:gravity="center"
      android:paddingStart="@dimen/_10"
      android:paddingEnd="@dimen/_10"
      android:text="@string/btn_delete"
      android:textColor="@color/style_color_error"
      android:textSize="@dimen/smaller_text_size" />
  </LinearLayout>

</LinearLayout>
