<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <shape android:shape="rectangle">
      <corners android:radius="@dimen/_10" />
      <solid android:color="@color/style_color_card_selected" />
      <stroke android:width="1dp" android:color="@color/style_color_primary" />
    </shape>
  </item>
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <corners android:radius="@dimen/_10" />
      <solid android:color="@color/style_color_card_pressed" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="@dimen/_10" />
      <solid android:color="@color/style_color_surface_variant" />
      <stroke android:width="1dp" android:color="@color/style_color_card_stroke" />
    </shape>
  </item>
</selector>
